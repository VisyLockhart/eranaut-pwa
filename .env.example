# Copy to .env and fill in. NEVER commit .env.
# 變數名稱為暫定,實作各功能時再定案。
NODE_ENV=development
PUBLIC_PORT=3000
INTERNAL_PORT=3001
DATABASE_PATH=./data/eranaut.db

# 有資格使用的身份組規則(D-143):`,` = 或、`+` = 且;例 A+B,C = (A 且 B) 或 C。
# 值為 Discord 身份組 ID(17~20 位數字)。空白或格式錯誤會讓服務啟動失敗。以下為假 ID,請換成真的。
ELIGIBLE_ROLE_RULE=111111111111111111+222222222222222222,333333333333333333

# Discord OAuth / bot(D-142、D-34)。以下為假值,請換成真的。
# 公開來源(同網域,不含路徑);Discord 後台需登記 ${PUBLIC_ORIGIN}/api/auth/callback
PUBLIC_ORIGIN=http://localhost:4200
# 本機 http 開發才設 false(session / state cookie 的 Secure 旗標)
COOKIE_SECURE=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 與 Eranarch 同一個 bot token
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# 伺服器顯示名稱:登入失敗畫面的「你還不是 XX 的成員」用(D-123),可與 Discord 後台名稱不同
GUILD_DISPLAY_NAME=XX 公會

# Eranarch 呼叫內部埠的共用密鑰(D-131 ①):至少 32 字元的隨機字串,Eranarch 的 .env 放同一組。以下為假值。
INTERNAL_API_SECRET=replace-with-a-long-random-string-0000000000

# 頻道 @ 提醒要發到的頻道 ID(D-72、D-129)。由伺服器管理員建立專用頻道並提供 ID;可留空(留空時使用者勾選頻道提醒會標記失敗)。
# Eranarch 需在該頻道有「檢視頻道」與「發送訊息」權限;頻道若為私有,bot 身份組需被允許。
REMINDER_CHANNEL_ID=

# 瀏覽器推播(D-165,選填):兩把 VAPID 金鑰都留空 = 不啟用推播(設定頁不顯示這一項)。
# 產生一組(只需做一次,之後不要換,換了所有人要重新開啟):npx web-push generate-vapid-keys
# VAPID_SUBJECT 是 mailto: 信箱或 https:// 網址(推播服務出問題時用來聯絡);留空則用 PUBLIC_ORIGIN(必須是 https)。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 每日資格比對需要 bot 開啟 Server Members Intent(特權 intent;Eranarch 已開啟)
